# =====================================================================
# Leafnet / NocoDB into Omnisend Middleware - Configuration Template
# =====================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=INFO
SYNC_INTERVAL_HOURS=24
DB_PATH=middleware.db

# Omnisend API Configuration
# Get from Omnisend Account -> Store Settings -> API keys
OMNISEND_API_KEY=your_omnisend_api_key_here
OMNISEND_BASE_URL=https://api.omnisend.com/v3

# NocoDB Configuration
# Base URL for self-hosted or cloud NocoDB (e.g., https://app.nocodb.com)
NOCODB_API_URL=https://app.nocodb.com
# xc-token generated in NocoDB user/API settings
NOCODB_API_TOKEN=your_nocodb_xc_token_here
# Table ID for the 'Leafnet Customers' table in NocoDB
NOCODB_TABLE_ID=your_customers_table_id_here
NOCODB_PAGE_SIZE=100

# Leafnet API Configuration
# Direct Leafnet API endpoint and credentials for customer verification & loyalty actions
LEAFNET_API_URL=https://snapdragon-hemp.haimenu.com/api/
LEAFNET_API_KEY=your_leafnet_api_key_here
LEAFNET_FOLDER_NAME=snapdragon-hemp

# Security / Verification
# Optional shared secret to verify Leafnet webhook signatures/headers
WEBHOOK_SECRET=your_optional_webhook_secret

# Segmentation & Loyalty Defaults
VIP_SPEND_THRESHOLD=500.0
